#pragma once

#include <hip/hip_runtime.h>
#include <hip/hip_fp16.h>
#include <stdint.h>

// ============================================================================
// VegaJet Minima-KV Mixed-Format Online-Softmax FlashDecoding Kernel (gfx906)
//   - Single-pass streaming decode across heterogeneous Q8_0 / Q4_0 / TQ3_3P5 pages!
//   - glc=1 slc=1 non-temporal loads on KV pages so KV scans never thrash L2!
//   - Split-KV across gridDim.y + exact LSE merge kernel for full 60-CU saturation!
//   - Strictly 0 B private spill (private_seg_size == 0), <= 48 VGPRs!
// ============================================================================

struct alignas(16) VjKvPageDescDev {
    uint64_t k_va;
    uint64_t v_va;
    uint32_t num_tokens;
    uint32_t format; // 0=Q8_0, 1=Q4_0, 2=TQ3_3P5
    uint32_t pad0;
    uint32_t pad1;
};

namespace vegajet {
namespace kvdev {

__device__ __forceinline__ uint32_t nt_load_u32(const uint32_t* p) {
    return __builtin_nontemporal_load(p);
}
__device__ __forceinline__ uint8_t nt_load_u8(const uint8_t* p) {
    return __builtin_nontemporal_load(p);
}
__device__ __forceinline__ uint16_t nt_load_u16(const uint16_t* p) {
    return __builtin_nontemporal_load(p);
}

__device__ __forceinline__ float wave64_sum(float v) {
    v += __shfl_xor(v, 32, 64);
    v += __shfl_xor(v, 16, 64);
    v += __shfl_xor(v, 8,  64);
    v += __shfl_xor(v, 4,  64);
    v += __shfl_xor(v, 2,  64);
    v += __shfl_xor(v, 1,  64);
    return v;
}

__device__ __forceinline__ float fwht64_wave(float x, uint32_t lane) {
    #pragma unroll
    for (uint32_t s = 1u; s < 64u; s <<= 1u) {
        float peer = __shfl_xor(x, static_cast<int>(s), 64);
        x = ((lane & s) == 0u) ? (x + peer) : (peer - x);
    }
    return x * 0.125f;
}

__device__ __forceinline__ float lloyd_max3_centroid(uint32_t code) {
    // Pure register-only symmetric lookup (0 LDS, 0 private spill!)
    const uint32_t mag = (code & 4u) ? (code & 3u) : (3u - (code & 3u));
    float val = (mag == 0u) ? 0.2451f :
                (mag == 1u) ? 0.7560f :
                (mag == 2u) ? 1.3439f : 2.1519f;
    return (code & 4u) ? val : -val;
}

__device__ __forceinline__ float load_kv_elem64(
    const uint8_t* vec_base,
    uint32_t fmt,
    uint32_t head_dim,
    uint32_t grp64,
    uint32_t lane) {
    const uint32_t d = grp64 * 64u + lane;
    if (fmt == 0u) {
        const uint32_t nb = head_dim >> 5;
        const uint16_t sc = nt_load_u16(reinterpret_cast<const uint16_t*>(vec_base) + (d >> 5));
        const int8_t q = static_cast<int8_t>(nt_load_u8(vec_base + nb * 2u + d));
        return __half2float(__ushort_as_half(sc)) * static_cast<float>(q);
    } else if (fmt == 1u) {
        const uint32_t nb = head_dim >> 5;
        const uint16_t sc = nt_load_u16(reinterpret_cast<const uint16_t*>(vec_base) + (d >> 5));
        const uint8_t packed = nt_load_u8(vec_base + nb * 2u + (d >> 1));
        int8_t q = ((d & 1u) == 0u)
                   ? (static_cast<int8_t>((packed & 0xFu) << 4) >> 4)
                   : (static_cast<int8_t>(packed & 0xF0u) >> 4);
        return __half2float(__ushort_as_half(sc)) * static_cast<float>(q);
    } else {
        const uint8_t* blk = vec_base + grp64 * 32u;
        const uint32_t hdr = nt_load_u32(reinterpret_cast<const uint32_t*>(blk));
        const float sigma = __half2float(__ushort_as_half(static_cast<uint16_t>(hdr & 0xFFFFu)));
        const float d_qjl = __half2float(__ushort_as_half(static_cast<uint16_t>(hdr >> 16)));
        const uint32_t bit = lane * 3u;
        const uint32_t w   = bit >> 5;
        const uint32_t sh  = bit & 31u;
        const uint32_t* lm3 = reinterpret_cast<const uint32_t*>(blk + 4u);
        uint32_t code = (nt_load_u32(lm3 + w) >> sh) & 7u;
        if (sh > 29u) {
            code |= ((nt_load_u32(lm3 + w + 1u) << (32u - sh)) & 7u);
        }
        const uint32_t qjl_signs = nt_load_u32(reinterpret_cast<const uint32_t*>(blk + 28u));
        const float sgn = ((qjl_signs >> (lane >> 1)) & 1u) ? 1.0f : -1.0f;
        return sigma * lloyd_max3_centroid(code) + d_qjl * sgn;
    }
}

__device__ __forceinline__ uint32_t kv_vec_stride_bytes(uint32_t fmt, uint32_t head_dim) {
    if (fmt == 0u) return (head_dim >> 5) * 2u + head_dim;
    if (fmt == 1u) return (head_dim >> 5) * 2u + (head_dim >> 1);
    return (head_dim >> 6) * 32u;
}

} // namespace kvdev
} // namespace vegajet

// ============================================================================
// Split-KV Mixed-Format Online-Softmax FlashDecoding Kernel
//   Grid: x = num_q_heads * 64 (1 Wave64 per Q-head x split), y = num_splits
//   Block: 64 (1 Wave64)
//   Uses 3 KiB LDS for Q, FWHT(Q), and running output O -> <= 44 VGPRs, 0 B spill!
// ============================================================================
extern "C" __global__ __launch_bounds__(64, 5)
void vj_flash_decode_mixed_kv_kernel(
    const float*           __restrict__ q_all,       // [num_q_heads, head_dim]
    const VjKvPageDescDev* __restrict__ pages,       // [num_pages]
    float*                 __restrict__ partial_o,   // [num_q_heads, num_splits, head_dim]
    float*                 __restrict__ partial_lse, // [num_q_heads, num_splits]
    uint32_t num_q_heads,
    uint32_t num_pages,
    uint32_t num_splits,
    uint32_t head_dim,
    float    inv_sqrt_d) {

    const uint32_t h    = blockIdx.x;
    const uint32_t sp   = blockIdx.y;
    const uint32_t lane = threadIdx.x;
    if (h >= num_q_heads || sp >= num_splits) return;

    __shared__ float sm_q[256];
    __shared__ float sm_qh[256];
    __shared__ float sm_o[256];

    const uint32_t ng = head_dim >> 6; // 1, 2, or 4 (D in {64, 128, 256})
    const float* qh = q_all + static_cast<uint64_t>(h) * head_dim;

    #pragma nounroll
    for (uint32_t g = 0u; g < ng; ++g) {
        const uint32_t d = g * 64u + lane;
        const float qv = qh[d];
        sm_q[d]  = qv;
        sm_qh[d] = vegajet::kvdev::fwht64_wave(qv, lane);
        sm_o[d]  = 0.0f;
    }

    const uint32_t p_per_sp = (num_pages + num_splits - 1u) / num_splits;
    const uint32_t p_beg    = sp * p_per_sp;
    const uint32_t p_end    = min(num_pages, p_beg + p_per_sp);

    float m_run = -1e30f;
    float l_run = 0.0f;

    for (uint32_t p = p_beg; p < p_end; ++p) {
        const VjKvPageDescDev desc = pages[p];
        const uint32_t fmt    = desc.format;
        const uint32_t stride = vegajet::kvdev::kv_vec_stride_bytes(fmt, head_dim);
        const uint8_t* k_base = reinterpret_cast<const uint8_t*>(desc.k_va);
        const uint8_t* v_base = reinterpret_cast<const uint8_t*>(desc.v_va);

        for (uint32_t t = 0u; t < desc.num_tokens; ++t) {
            const uint8_t* k_vec = k_base + static_cast<uint64_t>(t) * stride;
            const uint8_t* v_vec = v_base + static_cast<uint64_t>(t) * stride;

            float dot = 0.0f;
            #pragma nounroll
            for (uint32_t g = 0u; g < ng; ++g) {
                const uint32_t d = g * 64u + lane;
                const float qv = (fmt == 2u) ? sm_qh[d] : sm_q[d];
                const float kv = vegajet::kvdev::load_kv_elem64(k_vec, fmt, head_dim, g, lane);
                dot = fmaf(qv, kv, dot);
            }
            const float score = vegajet::kvdev::wave64_sum(dot) * inv_sqrt_d;

            const float m_new = fmaxf(m_run, score);
            const float alpha = __expf(m_run - m_new);
            const float beta  = __expf(score - m_new);
            l_run = l_run * alpha + beta;
            m_run = m_new;

            #pragma nounroll
            for (uint32_t g = 0u; g < ng; ++g) {
                const uint32_t d = g * 64u + lane;
                float vv = vegajet::kvdev::load_kv_elem64(v_vec, fmt, head_dim, g, lane);
                if (fmt == 2u) vv = vegajet::kvdev::fwht64_wave(vv, lane);
                sm_o[d] = fmaf(beta, vv, sm_o[d] * alpha);
            }
        }
    }

    const float inv_l = (l_run > 0.0f) ? (1.0f / l_run) : 0.0f;
    const uint64_t out_off = (static_cast<uint64_t>(h) * num_splits + sp) * head_dim;
    #pragma nounroll
    for (uint32_t g = 0u; g < ng; ++g) {
        const uint32_t d = g * 64u + lane;
        partial_o[out_off + d] = sm_o[d] * inv_l;
    }
    if (lane == 0u) {
        partial_lse[static_cast<uint64_t>(h) * num_splits + sp] = (l_run > 0.0f) ? (m_run + __logf(l_run)) : -1e30f;
    }
}

// ============================================================================
// Exact Split-KV LSE Merge Kernel (merges num_splits -> final [num_q_heads, head_dim])
//   Grid: num_q_heads * 64, Block: 64
// ============================================================================
extern "C" __global__ __launch_bounds__(64, 8)
void vj_flash_decode_lse_merge_kernel(
    const float* __restrict__ partial_o,   // [num_q_heads, num_splits, head_dim]
    const float* __restrict__ partial_lse, // [num_q_heads, num_splits]
    float*       __restrict__ out,         // [num_q_heads, head_dim]
    uint32_t num_q_heads,
    uint32_t num_splits,
    uint32_t head_dim) {

    const uint32_t h    = blockIdx.x;
    const uint32_t lane = threadIdx.x;
    if (h >= num_q_heads) return;

    float m = -1e30f;
    for (uint32_t s = 0u; s < num_splits; ++s) {
        m = fmaxf(m, partial_lse[static_cast<uint64_t>(h) * num_splits + s]);
    }
    float denom = 0.0f;
    for (uint32_t s = 0u; s < num_splits; ++s) {
        float lse = partial_lse[static_cast<uint64_t>(h) * num_splits + s];
        if (lse > -1e29f) denom += __expf(lse - m);
    }
    const float inv_d = (denom > 0.0f) ? (1.0f / denom) : 0.0f;

    for (uint32_t d = lane; d < head_dim; d += 64u) {
        float acc = 0.0f;
        for (uint32_t s = 0u; s < num_splits; ++s) {
            float lse = partial_lse[static_cast<uint64_t>(h) * num_splits + s];
            if (lse > -1e29f) {
                float w = __expf(lse - m) * inv_d;
                acc = fmaf(w, partial_o[(static_cast<uint64_t>(h) * num_splits + s) * head_dim + d], acc);
            }
        }
        out[static_cast<uint64_t>(h) * head_dim + d] = acc;
    }
}
