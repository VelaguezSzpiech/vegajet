#pragma once
#include <cstdint>
#include <cmath>
#if defined(__HIPCC__)
#include <hip/hip_runtime.h>
#include <hip/hip_fp16.h>
#define VJ_REFILL_HD __host__ __device__
#else
#define VJ_REFILL_HD
#endif

// Lossless palette codes from core/q4_dot8_repack.hpp, NOT linear Q4.
// Each 32-weight tile uses four words: byte j holds code j and code j+16.
// Cache-specific scale plane: one Scale per tile, preserving source FP16 d
// and the source scale nibble(s) verbatim. No host refill/upload is required.
namespace vj_refill {
enum class Source : uint32_t { iq2_s, iq3_xxs };
struct Tables { const uint64_t* iq2; const uint32_t* iq3; const uint8_t* signs; };
struct Scale { uint16_t d; uint8_t sub; uint8_t reserved; };
static_assert(sizeof(Scale) == 4, "scale wire");
VJ_REFILL_HD inline uint32_t stride(uint32_t bytes) {
    return (((bytes + 255u) / 256u) | 1u) * 256u;
}
VJ_REFILL_HD inline uint32_t u16(const uint8_t* p) { return p[0] | (uint32_t(p[1]) << 8); }
VJ_REFILL_HD inline uint32_t u32(const uint8_t* p) { return u16(p) | (u16(p + 2) << 16); }
VJ_REFILL_HD inline float half_float(uint16_t h) {
#if defined(__HIP_DEVICE_COMPILE__)
    return __half2float(__ushort_as_half(h));
#else
    const int e = (h >> 10) & 31, m = h & 1023;
    const float x = e == 0 ? std::ldexp(float(m), -24) :
        e == 31 ? (m ? NAN : INFINITY) : std::ldexp(float(1024 + m), e - 25);
    return (h & 32768) ? -x : x;
#endif
}
VJ_REFILL_HD inline uint32_t code(const uint8_t* p, Source type, uint32_t i, Tables t) {
    const uint32_t b = i / 32, l = (i % 32) / 8, j = i % 8;
    if (type == Source::iq2_s) {
        const uint32_t index = p[2 + b * 4 + l] | ((uint32_t(p[66 + b]) << (8 - 2 * l)) & 768);
        const uint32_t mag = uint32_t(t.iq2[index] >> (8 * j)) & 255;
        return (mag == 8 ? 0u : mag == 25 ? 1u : 2u) +
            3u * ((p[34 + b * 4 + l] >> j) & 1u);
    }
    const uint32_t aux = u32(p + 66 + b * 4);
    const uint32_t mag = (t.iq3[p[2 + b * 8 + l * 2 + j / 4]] >> (8 * (j % 4))) & 255;
    return ((mag - 4) / 8) | (((t.signs[(aux >> (7 * l)) & 127] >> j) & 1u) << 3);
}
VJ_REFILL_HD inline void repack32(const uint8_t* p, Source type, uint32_t sub,
                                 Tables t, uint32_t* words, Scale* scale) {
    *scale = {uint16_t(u16(p)), uint8_t(type == Source::iq2_s ? p[74 + sub] : u32(p + 66 + sub * 4) >> 28), 0};
#if defined(__HIPCC__)
    #pragma nounroll
#endif
    for (uint32_t w = 0; w < 4; ++w) {
        uint32_t packed = 0;
#if defined(__HIPCC__)
        #pragma nounroll
#endif
        for (uint32_t j = 0; j < 4; ++j)
            packed |= (code(p, type, sub * 32 + w * 4 + j, t) |
                (code(p, type, sub * 32 + 16 + w * 4 + j, t) << 4)) << (8 * j);
        words[w] = packed;
    }
}
VJ_REFILL_HD inline uint32_t perm(uint32_t hi, uint32_t lo, uint32_t sel) {
#if defined(__HIP_DEVICE_COMPILE__)
    uint32_t out;
    asm("v_perm_b32 %0, %1, %2, %3" : "=v"(out) : "v"(hi), "v"(lo), "v"(sel));
    return out;
#else
    const uint64_t in = (uint64_t(hi) << 32) | lo;
    uint32_t out = 0;
    for (uint32_t j = 0; j < 4; ++j) {
        const uint32_t s = (sel >> (j * 8)) & 255;
        const uint32_t b = s < 8 ? uint32_t(in >> (s * 8)) & 255 :
            s < 12 ? ((in >> ((s - 8) * 16 + 15)) & 1 ? 255 : 0) : s == 12 ? 0 : 255;
        out |= b << (j * 8);
    }
    return out;
#endif
}
VJ_REFILL_HD inline uint32_t decode4(uint32_t codes, Source type) {
    if (type == Source::iq2_s) return perm(0x0000d5e7u, 0xf82b1908u, codes & 0x07070707u);
    return perm(0x030707f8u, 0xf8f807f8u, codes) ^
        perm(0x3d332bdcu, 0xe4ec0bfcu, codes & 0x07070707u);
}
VJ_REFILL_HD inline float scale_value(Scale s, Source type, uint32_t half) {
    const uint32_t sub = type == Source::iq2_s ? (s.sub >> (half * 4)) & 15u : s.sub;
    return half_float(s.d) * (0.5f + float(sub)) * (type == Source::iq2_s ? 0.25f : 0.5f);
}
#if defined(__HIPCC__)
// Both 1024x3072 and 3072x1024; source is contiguous raw GGUF for one expert.
// Grid=ceil(rows*cols/32/256), block=256. Destination is an owned cache slot.
extern "C" __global__ __launch_bounds__(256, 5)
void vj_moe_lru_refill_dot8(const uint8_t* src, uint32_t* qs, Scale* ds,
                          uint32_t rows, uint32_t cols, Source type, Tables tables) {
    if (!cols || cols % 256) return;
    const uint64_t tile = uint64_t(blockIdx.x) * 256 + threadIdx.x;
    const uint32_t nb = cols / 32;
    if (tile >= uint64_t(rows) * nb) return;
    const uint32_t row = uint32_t(tile / nb), b = uint32_t(tile % nb);
    const uint8_t* in = src + (uint64_t(row) * (cols / 256) + b / 8) * (type == Source::iq2_s ? 82 : 98);
    auto* out = reinterpret_cast<uint32_t*>(reinterpret_cast<uint8_t*>(qs) + uint64_t(row) * stride(cols / 2));
    auto* scales = reinterpret_cast<Scale*>(reinterpret_cast<uint8_t*>(ds) + uint64_t(row) * stride(nb * sizeof(Scale)));
    repack32(in, type, b % 8, tables, out + b * 4, scales + b);
}
__device__ __forceinline__ int dot4(uint32_t w, uint32_t x, int sum) {
    asm("v_dot4_i32_i8 %0, %1, %2, %0" : "+v"(sum) : "v"(w), "v"(x)); return sum;
}
// Expert-grouped (slot,token) jobs support arbitrary M. x: contiguous signed
// int8 bytes per token, xd: float scale/32. y is job-major, no atomic scatter.
// Grid=(ceil(rows/4),jobs), block=256. stagger=0 preserves canonical K order;
// nonzero stagger rotates K tiles (exact re-code, but FP sum order may differ).
// Five blocks/CU bounds VGPR allocation; rolled loops keep dot4 live sets small.
extern "C" __global__ __launch_bounds__(256, 5)
void vj_moe_lru_hit_dot4(const uint32_t* qs, const Scale* ds,
    const uint32_t* x, const float* xd, const uint32_t* slots,
    const uint32_t* tokens, float* y, uint32_t rows, uint32_t cols,
    Source type, uint32_t stagger) {
    const uint32_t row = blockIdx.x * 4 + threadIdx.x / 64, lane = threadIdx.x % 64;
    if (row >= rows || !cols || cols % 256) return;
    const uint32_t nb = cols / 32, job = blockIdx.y;
    const uint64_t r = uint64_t(slots[job]) * rows + row;
    const auto* w = reinterpret_cast<const uint32_t*>(reinterpret_cast<const uint8_t*>(qs) + r * stride(cols / 2));
    const auto* s = reinterpret_cast<const Scale*>(reinterpret_cast<const uint8_t*>(ds) + r * stride(nb * sizeof(Scale)));
    const uint64_t token = tokens[job];
    const uint32_t start = (blockIdx.x * stagger) % nb;
    float acc = 0;
    #pragma nounroll
    for (uint32_t i = lane; i < nb; i += 64) {
        const uint32_t b = (start + i) % nb;
        #pragma nounroll
        for (uint32_t h = 0; h < 2; ++h) {
            int dp = 0;
            #pragma nounroll
            for (uint32_t j = 0; j < 4; ++j) {
                const uint32_t bytes = decode4((w[b * 4 + j] >> (h * 4)) & 0x0f0f0f0fu, type);
                dp = dot4(bytes, x[(token * nb + b) * 8 + h * 4 + j], dp);
            }
            acc = fmaf(scale_value(s[b], type, h) * xd[token * nb + b], float(dp), acc);
        }
    }
    for (uint32_t delta = 32; delta; delta /= 2) acc += __shfl_down(acc, delta, 64);
    if (!lane) y[uint64_t(job) * rows + row] = acc;
}
// Packed signed-int4 activations, contiguous in groups of eight.
// Two exact signed-nibble dots implement the non-linear signed palette.
extern "C" __global__ __launch_bounds__(256, 5)
void vj_moe_lru_hit_dot8(const uint32_t* qs, const Scale* ds,
    const uint32_t* x, const float* xd, const uint32_t* slots,
    const uint32_t* tokens, float* y, uint32_t rows, uint32_t cols,
    Source type, uint32_t stagger) {
    const uint32_t row = blockIdx.x * 4 + threadIdx.x / 64, lane = threadIdx.x % 64;
    if (row >= rows || !cols || cols % 256) return;
    const uint32_t nb = cols / 32, job = blockIdx.y;
    const uint64_t r = uint64_t(slots[job]) * rows + row;
    const auto* w = reinterpret_cast<const uint32_t*>(reinterpret_cast<const uint8_t*>(qs) + r * stride(cols / 2));
    const auto* s = reinterpret_cast<const Scale*>(reinterpret_cast<const uint8_t*>(ds) + r * stride(nb * sizeof(Scale)));
    const uint64_t token = tokens[job];
    const uint32_t start = (blockIdx.x * stagger) % nb;
    float acc = 0;
    #pragma nounroll
    for (uint32_t i = lane; i < nb; i += 64) {
        const uint32_t b = (start + i) % nb;
        #pragma nounroll
        for (uint32_t h = 0; h < 2; ++h) {
            int dp = 0;
            #pragma nounroll
            for (uint32_t j = 0; j < 2; ++j) {
                uint32_t low=0, high=0;
                #pragma nounroll
                for (uint32_t u=0;u<2;++u) {
                    uint32_t v=decode4((w[b*4+2*j+u]>>(4*h))&0x0f0f0f0fu,type);
                    #pragma unroll
                    for(uint32_t c=0;c<4;++c){
                        int weight=int(int8_t(v>>(8*c))); unsigned shift=16*u+4*c;
                        int lo=int((unsigned(weight)+8u)&15u)-8;
                        low|=(unsigned(lo)&15u)<<shift;
                        high|=(unsigned((weight-lo)/16)&15u)<<shift;
                    }
                }
                uint32_t activ=x[(token*nb+b)*4+h*2+j];int l=0,hi=0;
                asm("v_dot8_i32_i4 %0, %1, %2, %0" : "+v"(l) : "v"(low),"v"(activ));
                asm("v_dot8_i32_i4 %0, %1, %2, %0" : "+v"(hi) : "v"(high),"v"(activ));
                dp+=l+16*hi;
            }
            acc = fmaf(scale_value(s[b], type, h) * xd[token * nb + b], float(dp), acc);
        }
    }
    for (uint32_t delta = 32; delta; delta /= 2) acc += __shfl_down(acc, delta, 64);
    if (!lane) y[uint64_t(job) * rows + row] = acc;
}
#endif
} // namespace vj_refill
#undef VJ_REFILL_HD
